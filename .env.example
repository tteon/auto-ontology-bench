# Copy to .env (git-ignored) and fill in. Nothing in this file is secret.

# --- LLM / embeddings: NVIDIA API catalog (https://build.nvidia.com) ---
NVIDIA_API_KEY=nvapi-...
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b          # query generation (model under test)
EXTRACT_MODEL=nvidia/nemotron-3-ultra-550b-a55b           # data extraction (kept different from the model under test)

# --- SEC EDGAR: SEC requires a declared User-Agent "Name contact@example.com" ---
SEC_UA="Your Name your.email@example.com"

# --- Neo4j Enterprise (AuraDB Professional/Enterprise, or self-hosted neo4j:5-enterprise) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...
NEO4J_DATABASE=neo4j

# --- Benchmark Postgres (docker/compose.yml) ---
BENCH_PG_PORT=55432
BENCH_PG_PASSWORD=change-me
BENCH_PG_RO_PASSWORD=change-me-too
# PG_CPUSET=0-3,8-11            # pin to as many logical CPUs as your Neo4j has processors
# AUTO_ONTOLOGY_NETWORK=auto-ontology_default

# --- Auto-Ontology backend (NVIDIA/auto-ontology, docker compose) ---
AUTO_ONTOLOGY_API_URL=http://127.0.0.1:3001
